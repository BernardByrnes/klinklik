DJANGO_SETTINGS_MODULE=clinicopus.settings
DJANGO_SECRET_KEY=replace-me-in-development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave DB_ENGINE=sqlite for local foundation work.
DB_ENGINE=sqlite
DB_NAME=backend/db.sqlite3

# Local Docker PostgreSQL bootstrap values. Keep actual values in an ignored .env file.
POSTGRES_PASSWORD=replace-me-in-development
POSTGRES_APP_PASSWORD=replace-me-in-development

# PostgreSQL deployment values.
# DB_ENGINE=postgresql
# DB_NAME=clinicopus
# DB_USER=clinicopus_app
# DB_PASSWORD=replace-me
# DB_HOST=127.0.0.1
# DB_PORT=5432

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=0
FRONTEND_ORIGIN=http://localhost:3000
